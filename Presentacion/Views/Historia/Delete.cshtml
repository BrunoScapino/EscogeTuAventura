@model DTOs.DTOs.HistoriaDTO

@{
    ViewData["Title"] = "Eliminar historia";
}

<h1>Eliminar historia</h1>

<div class="alert alert-warning">
    ¿Confirmás que querés eliminar esta historia?
    También se eliminarán sus capítulos y opciones.
    Esta acción no se puede deshacer.
</div>

<dl class="row">
    <dt class="col-sm-3">Título</dt>
    <dd class="col-sm-9">@Model.Titulo</dd>

    <dt class="col-sm-3">Sinopsis</dt>
    <dd class="col-sm-9">@Model.Sinopsis</dd>

    <dt class="col-sm-3">Estado</dt>
    <dd class="col-sm-9">@Model.Estado</dd>
</dl>

<p>
    Si tiene lecturas asociadas, el sistema impedirá la eliminación.
</p>

<form asp-action="Delete" asp-route-id="@Model.Id" method="post">
    <button type="submit" class="btn btn-danger">
        Confirmar eliminación
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Cancelar
    </a>
</form>