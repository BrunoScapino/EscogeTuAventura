@model List<DTOs.DTOs.HistoriaDTO>

@{
    ViewData["Title"] = "Historias";
}

<h1>Historias</h1>

@if (TempData["Mensaje"] is string mensaje)
{
    <div class="alert alert-success">
        @mensaje
    </div>
}

@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">
        @error
    </div>
}

<p>
    <a asp-action="Create" class="btn btn-primary">
        Crear historia
    </a>
</p>

@if (Model.Count == 0)
{
    <div class="alert alert-info">
        No hay historias registradas.
    </div>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Título</th>
                <th>Sinopsis</th>
                <th>Estado</th>
                <th>Capítulo inicial</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var historia in Model)
            {
                <tr>
                    <td>@historia.Titulo</td>
                    <td>@historia.Sinopsis</td>
                    <td>@historia.Estado</td>
                    <td>@historia.TituloCapituloInicial</td>
                    <td>
                        <a asp-action="Edit"
                           asp-route-id="@historia.Id"
                           class="btn btn-warning btn-sm">
                            Editar
                        </a>

                        <a asp-action="Delete"
                           asp-route-id="@historia.Id"
                           class="btn btn-danger btn-sm">
                            Eliminar
                       </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}