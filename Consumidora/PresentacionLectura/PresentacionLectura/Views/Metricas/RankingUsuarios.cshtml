@model List<PresentacionLectura.Models.RankingUsuarioApiDTO>

@{
    ViewData["Title"] = "Ranking de usuarios";
}

<div class="container mt-4">
    <h1>Ranking de usuarios</h1>

    <p class="text-muted">
        Usuarios ordenados según la cantidad de historias distintas que completaron.
    </p>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">
            @ViewBag.Error
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            Todavía no hay usuarios que hayan completado historias.
        </div>
    }
    else
    {
        <table class="table table-striped table-hover mt-3">
            <thead class="table-dark">
                <tr>
                    <th>Posición</th>
                    <th>Usuario</th>
                    <th>Historias completadas</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int posicion = 1;
                }

                @foreach (var usuario in Model)
                {
                    <tr>
                        <td>@posicion</td>
                        <td>@usuario.NombreUsuario</td>
                        <td>@usuario.CantidadHistoriasCompletadas</td>
                    </tr>

                    posicion++;
                }
            </tbody>
        </table>
    }

    <a asp-controller="Historia"
       asp-action="Index"
       class="btn btn-secondary">
        Volver
    </a>
</div>