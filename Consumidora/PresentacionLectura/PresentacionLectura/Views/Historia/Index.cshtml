@model List<PresentacionLectura.Models.HistoriaApiDTO>

@{
    ViewData["Title"] = "Historias";

    var categorias = ViewBag.Categorias as
        List<PresentacionLectura.Models.CategoriaApiDTO>
        ?? new List<PresentacionLectura.Models.CategoriaApiDTO>();

    string categoriaSeleccionada =
        Context.Request.Query["categoriaId"].ToString();
}

<div class="text-center mb-4">
    <h1>Historias publicadas</h1>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<form asp-action="Index" method="get" class="mb-4">
    <div class="row">
        <div class="col-md-4">
            <label class="form-label">Categoría</label>

            <select name="categoriaId" class="form-select">
                <option value="">Todas las categorías</option>

                @foreach (var categoria in categorias)
                {
                    if (categoriaSeleccionada == categoria.Id.ToString())
                    {
                        <option value="@categoria.Id" selected>
                            @categoria.Nombre
                        </option>
                    }
                    else
                    {
                        <option value="@categoria.Id">
                            @categoria.Nombre
                        </option>
                    }
                }
            </select>
        </div>

        <div class="col-md-2 d-flex align-items-end">
            <button type="submit" class="btn btn-primary">
                Filtrar
            </button>
        </div>

        <div class="col-md-2 d-flex align-items-end">
            <a asp-action="Index" class="btn btn-secondary">
                Limpiar
            </a>
        </div>
    </div>
</form>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">
        @ViewBag.Error
    </div>
}
else if (!Model.Any())
{
    <p>No hay historias publicadas disponibles.</p>
}
else
{
    <div class="row">
        @foreach (var historia in Model)
        {
            <div class="col-md-4 mb-3">
                <div class="card h-100">
                    <div class="card-body">
                        <h4 class="card-title">@historia.Titulo</h4>
                        <p class="card-text">@historia.Sinopsis</p>
                        <a asp-controller="Lectura"
                           asp-action="Iniciar"
                           asp-route-capituloInicialId="@historia.CapituloInicialId"
                           asp-route-historiaId="@historia.Id"
                           class="btn btn-primary">
                            Leer historia
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}