@using Microsoft.AspNetCore.Http

@{
    bool sesionIniciada =
        !string.IsNullOrEmpty(
            Context.Session.GetString("token"));
        
    string rol = Context.Session.GetString("rol") ?? string.Empty;
    bool esAdministrador = rol == "Administrador";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Escoge tu aventura</title>

    <script type="importmap"></script>
    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
    <link rel="stylesheet"
          href="~/PresentacionLectura.styles.css"
          asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand"
                   asp-controller="Historia"
                   asp-action="Index">
                    Escoge tu aventura
                </a>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @if (sesionIniciada)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark"
                                   asp-controller="Historia"
                                   asp-action="Index">
                                    Historias
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-dark"
                                   asp-controller="Lectura"
                                   asp-action="Historial">
                                    Mi historial
                                </a>
                            </li>

                            <li class="nav-item">
                                <form asp-controller="Auth"
                                      asp-action="Logout"
                                      method="post"
                                      class="d-inline">
                                    <button type="submit"
                                            class="nav-link text-dark border-0 bg-transparent">
                                        Cerrar sesión
                                    </button>
                                </form>
                            </li>
                            @if (esAdministrador)
                                {
                                    <li class="nav-item">
                                        <a class="nav-link text-dark"
                                           asp-controller="Metricas"
                                           asp-action="RankingHistorias">
                                            Ranking de historias
                                        </a>
                                    </li>
                                }
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark"
                                   asp-controller="Auth"
                                   asp-action="Login">
                                    Iniciar sesión
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Escoge tu aventura
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>